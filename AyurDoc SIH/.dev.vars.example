# Copy this file to .dev.vars for local email delivery.
# Never commit a real API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AyurDoc <reports@your-verified-domain.com>

# OpenAI server integrations (never expose this key in browser code)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ABDM Sandbox HIP/HIU
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIU_ID=
ABDM_HIP_ID=
ABDM_REQUESTER_ID=
ABDM_CALLBACK_URL=

# Hospital FHIR R4 endpoint
FHIR_BASE_URL=
FHIR_AUTH_TOKEN=
